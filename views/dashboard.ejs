<%- include("partials/header", { titre: "Tableau de bord" }) %>

<div class="carte">
  <h1>Tableau de bord</h1>

  <!--
    NB : <%= session.userId %> est echappe automatiquement par EJS.
    Meme si un identifiant piege etait stocke, il serait affiche
    comme du texte, jamais execute (defense XSS, Lecon 5).
  -->
  <p>Bonjour <strong><%= session.username %></strong>,
     vous etes connecte avec le role <strong><%= session.role %></strong>.</p>

  <h2>Etat de l'infrastructure (demo)</h2>
  <table>
    <tr><th>Service</th><th>Etat</th></tr>
    <tr><td>Serveur web</td><td>Operationnel</td></tr>
    <tr><td>Base de donnees</td><td>Connectee (PostgreSQL)</td></tr>
    <tr><td>Double authentification</td><td>Activee (TOTP)</td></tr>
    <tr><td>Controle d'acces</td><td>RBAC - 3 roles</td></tr>
  </table>

  <% if (session.role === "admin" || session.role === "superadmin") { %>
    <h2>Administration</h2>
    <p><a class="btn-lien" href="/admin/users">Gerer les utilisateurs</a></p>
  <% } %>
</div>

<%- include("partials/footer") %>
