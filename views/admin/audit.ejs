<%- include("../partials/header", { titre: "Journal d'audit" }) %>

<div class="carte">
  <h1>Journal d'audit</h1>

  <p class="muted">Les 100 derniers &eacute;v&eacute;nements sensibles, du plus r&eacute;cent
     au plus ancien. Journal en ajout seul (append-only) : il ne peut
     &ecirc;tre ni modifi&eacute; ni supprim&eacute; depuis l'application.</p>

  <% if (evenements.length === 0) { %>
    <p>Aucun &eacute;v&eacute;nement enregistr&eacute; pour le moment.</p>
  <% } else { %>
    <table class="table-audit">
      <tr>
        <th>Horodatage</th>
        <th>S&eacute;v&eacute;rit&eacute;</th>
        <th>Action</th>
        <th>Utilisateur</th>
        <th>IP</th>
        <th>D&eacute;tails</th>
      </tr>
      <% evenements.forEach(function(e) { %>
        <tr>
          <td class="mono"><%= e.horodatage %></td>
          <td><span class="badge-level level-<%= e.level %>"><%= e.level %></span></td>
          <td><strong><%= e.action %></strong></td>
          <td><%= e.username || "-" %></td>
          <td class="mono"><%= e.ip || "-" %></td>
          <td class="mono details">
            <%= e.details ? JSON.stringify(e.details) : "-" %>
          </td>
        </tr>
      <% }); %>
    </table>
  <% } %>
</div>

<%- include("../partials/footer") %>
