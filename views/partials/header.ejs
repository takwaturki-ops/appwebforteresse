<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titre %> | Forteresse</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="bandeau">
    <span class="logo">Forteresse</span>
    <nav>
      <% if (session && session.userId) { %>
        <span>Connecte : <%= session.userId %></span>
        <form method="POST" action="/logout" class="inline">
          <button type="submit" class="lien">Deconnexion</button>
        </form>
      <% } %>
    </nav>
  </header>
  <main class="contenu">
